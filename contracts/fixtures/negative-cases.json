[
  {
    "name": "system-field-write",
    "input": {
      "status": "APPROVED",
      "version": 99
    },
    "expected": "400",
    "assertion": "Reject server-owned command fields",
    "status": "DESIGN_ONLY"
  },
  {
    "name": "other-department-approval",
    "input": {
      "command": "approve",
      "role": "role_procurement_manager",
      "record_org_unit_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
      "actor_org_unit_id": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"
    },
    "expected": "404",
    "assertion": "A department-scoped role neither sees nor acts on another department's record",
    "status": "TESTED"
  },
  {
    "name": "self-approval",
    "input": {
      "command": "approve",
      "created_by": "22222222-2222-4222-8222-222222222222",
      "actor_id": "22222222-2222-4222-8222-222222222222"
    },
    "expected": "403",
    "assertion": "recordFilter rejects self approval",
    "status": "TESTED"
  },
  {
    "name": "unsupported-filter",
    "input": {
      "recordFilter": {
        "created_by": {
          "_like": "%"
        }
      }
    },
    "expected": "reject-before-write",
    "assertion": "Unsupported operator",
    "status": "DESIGN_ONLY"
  },
  {
    "name": "semantic-declaration",
    "input": {
      "semanticType": "urn:example:amount"
    },
    "expected": "reject-before-write",
    "assertion": "Unsupported semantic declaration",
    "status": "DESIGN_ONLY"
  },
  {
    "name": "ungranted-role",
    "input": {
      "X-Hasura-Role": "role_procurement_finance",
      "held_roles": [
        "role_procurement_requester"
      ]
    },
    "expected": "403",
    "assertion": "A role the caller does not hold in core.user_roles is refused",
    "status": "TESTED"
  }
]
