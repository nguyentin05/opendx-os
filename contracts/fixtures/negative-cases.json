[
  {
    "name": "system-field-write",
    "input": {
      "status": "APPROVED",
      "version": 99
    },
    "expected": "400",
    "assertion": "Reject server-owned command fields",
    "status": "DESIGN_ONLY"
  },
  {
    "name": "cross-workspace-fk",
    "input": {
      "workspace_id": "11111111-1111-4111-8111-111111111111",
      "foreign_workspace_id": "55555555-5555-4555-8555-555555555555"
    },
    "expected": "reject",
    "assertion": "Reject same-workspace FK mismatch",
    "status": "DESIGN_ONLY"
  },
  {
    "name": "self-approval",
    "input": {
      "command": "approve",
      "requester_id": "22222222-2222-4222-8222-222222222222",
      "actor_id": "22222222-2222-4222-8222-222222222222"
    },
    "expected": "403",
    "assertion": "recordFilter rejects self approval",
    "status": "DESIGN_ONLY"
  },
  {
    "name": "unsupported-filter",
    "input": {
      "recordFilter": {
        "requester_id": {
          "_like": "%"
        }
      }
    },
    "expected": "reject-before-write",
    "assertion": "Unsupported operator",
    "status": "DESIGN_ONLY"
  },
  {
    "name": "semantic-declaration",
    "input": {
      "semanticType": "urn:example:amount"
    },
    "expected": "reject-before-write",
    "assertion": "Unsupported semantic declaration",
    "status": "DESIGN_ONLY"
  },
  {
    "name": "malformed-claims",
    "input": {
      "x-hasura-allowed-roles": "role_procurement"
    },
    "expected": "401",
    "assertion": "Roles must be signed array",
    "status": "DESIGN_ONLY"
  },
  {
    "name": "ungranted-role",
    "input": {
      "selected_role": "admin",
      "allowed_roles": [
        "role_procurement"
      ]
    },
    "expected": "403",
    "assertion": "Role selection cannot expand grant",
    "status": "DESIGN_ONLY"
  }
]
