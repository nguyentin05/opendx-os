{
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "command.committed"
    },
    "app_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "entity_type": {
      "type": "string",
      "pattern": "^domain\\.[a-z][a-z0-9_]*$"
    },
    "entity_id": {
      "type": "string",
      "format": "uuid"
    },
    "entity_version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "actor_id": {
          "type": "string",
          "format": "uuid"
        },
        "acting_role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "from_status": {
          "type": "string",
          "minLength": 1
        },
        "to_status": {
          "type": "string",
          "minLength": 1
        },
        "executed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "command",
        "actor_id",
        "acting_role",
        "from_status",
        "to_status",
        "executed_at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "app_id",
    "entity_type",
    "entity_id",
    "entity_version",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dxos.io/contracts/events-v1.schema.json",
  "title": "PROPOSED process event envelope v1",
  "$comment": "At least once; retries preserve the complete envelope and event_id. DB id maps to wire event_id. No authority derives from payload."
}
