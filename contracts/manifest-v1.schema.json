{
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "dxos.io/v1alpha1"
    },
    "kind": {
      "const": "DXApplication"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "displayName",
        "version"
      ],
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "sharedAccess": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "table": {
                "enum": [
                  "core.employees",
                  "core.work_items",
                  "core.file_objects"
                ]
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "table",
              "roles",
              "columns"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "domainTable": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^domain\\.[a-z][a-z0-9_]*$"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "type": {
                    "enum": [
                      "uuid",
                      "text",
                      "date",
                      "numeric(14,2)",
                      "numeric(4,2)"
                    ]
                  },
                  "nullable": {
                    "type": "boolean"
                  },
                  "check": {
                    "type": "string",
                    "pattern": "^(length\\(trim\\([a-z][a-z0-9_]*\\)\\) > 0|[a-z][a-z0-9_]* > 0|[a-z][a-z0-9_]* > 0 AND [a-z][a-z0-9_]* <= 24)$"
                  }
                },
                "required": [
                  "name",
                  "type",
                  "nullable"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "compositeForeignKeys": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "referencesTable": {
                    "enum": [
                      "core.employees",
                      "core.work_items",
                      "core.file_objects"
                    ]
                  },
                  "referencesColumns": {
                    "const": [
                      "workspace_id",
                      "id"
                    ]
                  }
                },
                "required": [
                  "columns",
                  "referencesTable",
                  "referencesColumns"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "name",
            "columns",
            "compositeForeignKeys"
          ],
          "additionalProperties": false
        },
        "domainAccess": {
          "type": "object",
          "properties": {
            "select": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "recordFilter": {
                    "$ref": "#/$defs/filter"
                  },
                  "presets": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "additionalProperties": {
                      "enum": [
                        "X-Hasura-User-Id",
                        "X-Hasura-Workspace-Id"
                      ]
                    }
                  }
                },
                "required": [
                  "role",
                  "columns"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "insert": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "recordFilter": {
                    "$ref": "#/$defs/filter"
                  },
                  "presets": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "additionalProperties": {
                      "enum": [
                        "X-Hasura-User-Id",
                        "X-Hasura-Workspace-Id"
                      ]
                    }
                  }
                },
                "required": [
                  "role",
                  "columns"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "update": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "recordFilter": {
                    "$ref": "#/$defs/filter"
                  },
                  "presets": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "additionalProperties": {
                      "enum": [
                        "X-Hasura-User-Id",
                        "X-Hasura-Workspace-Id"
                      ]
                    }
                  }
                },
                "required": [
                  "role",
                  "columns"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "select",
            "insert",
            "update"
          ],
          "additionalProperties": false
        },
        "stateMachine": {
          "type": "object",
          "properties": {
            "initial": {
              "type": "string",
              "minLength": 1
            },
            "editableStates": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "terminalStates": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "commands": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "from": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "to": {
                    "type": "string",
                    "minLength": 1
                  },
                  "allowedRoles": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "recordFilter": {
                    "$ref": "#/$defs/filter"
                  }
                },
                "required": [
                  "name",
                  "from",
                  "to",
                  "allowedRoles"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "initial",
            "editableStates",
            "terminalStates",
            "commands"
          ],
          "additionalProperties": false
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "column": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "requireCleanOnCommands": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "column",
              "requireCleanOnCommands"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "file": {
                "type": "string",
                "pattern": "^workflows/[a-z][a-z0-9_]*\\.yaml$"
              },
              "subscribedEvents": {
                "type": "array",
                "items": {
                  "const": "command.committed"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "effects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "stepName": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "kind": {
                      "const": "create_work_item"
                    },
                    "whenCommands": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$"
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "fields": {
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string",
                          "minLength": 1
                        },
                        "description": {
                          "type": "string"
                        },
                        "priority": {
                          "enum": [
                            "LOW",
                            "MEDIUM",
                            "HIGH",
                            "CRITICAL"
                          ]
                        },
                        "assignedEmployeeId": {
                          "type": "string",
                          "format": "uuid"
                        }
                      },
                      "required": [
                        "title",
                        "description",
                        "priority"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "stepName",
                    "kind",
                    "whenCommands",
                    "fields"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "file",
              "subscribedEvents",
              "effects"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "cap-process"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "uiSchema": {
          "type": "object",
          "properties": {
            "listColumns": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "formFields": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "enum": [
                      "uuid",
                      "text",
                      "number",
                      "file",
                      "date"
                    ]
                  },
                  "required": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "label",
                  "type",
                  "required"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "listColumns",
            "formFields",
            "actions"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "role",
        "sharedAccess",
        "domainTable",
        "domainAccess",
        "stateMachine",
        "attachments",
        "workflows",
        "capabilities",
        "uiSchema"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dxos.io/contracts/manifest-v1.schema.json",
  "title": "PROPOSED C0 core manifest v1",
  "$defs": {
    "filter": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "_and": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/filter"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "_or": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/filter"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "_eq": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "_neq": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$comment": "Structural validation only. Mandatory semantic validation is specified in README.md; B approval and validator implementation pending. Unsupported semanticType, raw SQL and unknown properties are rejected."
}
