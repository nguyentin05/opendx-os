{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dxos.io/contracts/manifest-v1.schema.json",
  "title": "DXApplication manifest (dxos.io/v1alpha1)",
  "$comment": "Generated by scripts/gen-manifest-schema.py from the DXApplication CRD (operator/config/crd/bases). Semantic rules (declared roles, scopes, capabilities, column references) are enforced by operator/internal/manifest.Validate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "dxos.io/v1alpha1"
    },
    "kind": {
      "const": "DXApplication"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "displayName",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "spec": {
      "description": "DXApplicationSpec mirrors the DXApplication manifest contract\n(docs/contracts/data-contracts.md). JSON field names are identical to the\nmanifest so that both forms convert losslessly.",
      "properties": {
        "capabilities": {
          "description": "Capabilities lists the Tier 2 capabilities the application depends on.\ncap-process is required.",
          "items": {
            "pattern": "^cap-[a-z]+$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "roles": {
          "description": "Roles are owned by this application; no other application may use them.",
          "items": {
            "description": "Role is one application role (core.roles).",
            "properties": {
              "description": {
                "type": "string"
              },
              "name": {
                "description": "Role names start with role_: Hasura treats some names (admin) as\nprivileged, and the prefix keeps application roles out of that space.",
                "pattern": "^role_[a-z0-9_]+$",
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "type": "object",
            "additionalProperties": false
          },
          "minItems": 1,
          "type": "array"
        },
        "sharedAccess": {
          "description": "SharedAccess declares the shared Tier 1 and Tier 2 tables, columns and\nroles the application reads.",
          "items": {
            "description": "SharedAccess grants read access to a shared Tier 1 or Tier 2 table.",
            "properties": {
              "columns": {
                "items": {
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "roles": {
                "items": {
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "table": {
                "pattern": "^(core|cap_[a-z]+)\\.[a-z][a-z0-9_]*$",
                "type": "string"
              }
            },
            "required": [
              "columns",
              "roles",
              "table"
            ],
            "type": "object",
            "additionalProperties": false
          },
          "type": "array"
        },
        "tables": {
          "description": "Tables declares the application's domain tables (ADR 0008). The Operator\ngenerates each of them. A table with a state machine is a process table;\none without is a plain table.",
          "items": {
            "description": "Table describes one domain table with its access rules, lifecycle and UI.",
            "properties": {
              "access": {
                "description": "Access declares per-role select/insert/update rules on the table.",
                "properties": {
                  "delete": {
                    "description": "Delete is allowed on child tables only.",
                    "items": {
                      "description": "DeleteRule lets a role delete rows of a child table while it may edit their\nparent record.",
                      "properties": {
                        "role": {
                          "pattern": "^[a-z][a-z0-9_]*$",
                          "type": "string"
                        }
                      },
                      "required": [
                        "role"
                      ],
                      "type": "object",
                      "additionalProperties": false
                    },
                    "type": "array"
                  },
                  "insert": {
                    "items": {
                      "description": "AccessRule allows one role a set of columns within its scope, optionally\nnarrowed by a record filter.",
                      "properties": {
                        "columns": {
                          "items": {
                            "type": "string"
                          },
                          "minItems": 1,
                          "type": "array"
                        },
                        "presets": {
                          "additionalProperties": {
                            "type": "string"
                          },
                          "description": "Presets set uuid columns from X-Hasura-User-Id (insert only).",
                          "type": "object"
                        },
                        "recordFilter": {
                          "description": "RecordFilter is a Hasura boolean expression over declared columns.",
                          "type": "object"
                        },
                        "role": {
                          "pattern": "^[a-z][a-z0-9_]*$",
                          "type": "string"
                        },
                        "scope": {
                          "description": "Scope is required on select and update: own records, own department\n(requires cap-hr) or the whole organization. Not allowed on insert, nor\non a child table, whose rows follow their parent record.",
                          "enum": [
                            "own",
                            "department",
                            "organization"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "columns",
                        "role"
                      ],
                      "type": "object",
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "select": {
                    "items": {
                      "description": "AccessRule allows one role a set of columns within its scope, optionally\nnarrowed by a record filter.",
                      "properties": {
                        "columns": {
                          "items": {
                            "type": "string"
                          },
                          "minItems": 1,
                          "type": "array"
                        },
                        "presets": {
                          "additionalProperties": {
                            "type": "string"
                          },
                          "description": "Presets set uuid columns from X-Hasura-User-Id (insert only).",
                          "type": "object"
                        },
                        "recordFilter": {
                          "description": "RecordFilter is a Hasura boolean expression over declared columns.",
                          "type": "object"
                        },
                        "role": {
                          "pattern": "^[a-z][a-z0-9_]*$",
                          "type": "string"
                        },
                        "scope": {
                          "description": "Scope is required on select and update: own records, own department\n(requires cap-hr) or the whole organization. Not allowed on insert, nor\non a child table, whose rows follow their parent record.",
                          "enum": [
                            "own",
                            "department",
                            "organization"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "columns",
                        "role"
                      ],
                      "type": "object",
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "update": {
                    "items": {
                      "description": "AccessRule allows one role a set of columns within its scope, optionally\nnarrowed by a record filter.",
                      "properties": {
                        "columns": {
                          "items": {
                            "type": "string"
                          },
                          "minItems": 1,
                          "type": "array"
                        },
                        "presets": {
                          "additionalProperties": {
                            "type": "string"
                          },
                          "description": "Presets set uuid columns from X-Hasura-User-Id (insert only).",
                          "type": "object"
                        },
                        "recordFilter": {
                          "description": "RecordFilter is a Hasura boolean expression over declared columns.",
                          "type": "object"
                        },
                        "role": {
                          "pattern": "^[a-z][a-z0-9_]*$",
                          "type": "string"
                        },
                        "scope": {
                          "description": "Scope is required on select and update: own records, own department\n(requires cap-hr) or the whole organization. Not allowed on insert, nor\non a child table, whose rows follow their parent record.",
                          "enum": [
                            "own",
                            "department",
                            "organization"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "columns",
                        "role"
                      ],
                      "type": "object",
                      "additionalProperties": false
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "insert",
                  "select"
                ],
                "type": "object",
                "additionalProperties": false
              },
              "attachments": {
                "description": "Attachments binds file columns to commands that require a CLEAN scan.",
                "items": {
                  "description": "Attachment binds a file column to the commands that require a CLEAN file.",
                  "properties": {
                    "column": {
                      "pattern": "^[a-z][a-z0-9_]*$",
                      "type": "string"
                    },
                    "requireCleanOnCommands": {
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1,
                      "type": "array"
                    }
                  },
                  "required": [
                    "column",
                    "requireCleanOnCommands"
                  ],
                  "type": "object",
                  "additionalProperties": false
                },
                "type": "array"
              },
              "belongsTo": {
                "description": "BelongsTo makes the table a child table: its rows are part of a record\nof the parent table and follow that record's access, state and version.",
                "properties": {
                  "column": {
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "type": "string"
                  },
                  "table": {
                    "pattern": "^domain\\.[a-z][a-z0-9_]*$",
                    "type": "string"
                  }
                },
                "required": [
                  "column",
                  "table"
                ],
                "type": "object",
                "additionalProperties": false
              },
              "columns": {
                "items": {
                  "description": "Column is a business column; system columns are managed by the Operator.",
                  "properties": {
                    "check": {
                      "description": "Check is a SQL CHECK expression from the validator's allowlist.",
                      "type": "string"
                    },
                    "name": {
                      "pattern": "^[a-z][a-z0-9_]*$",
                      "type": "string"
                    },
                    "nullable": {
                      "description": "Nullable is required so that additive upgrades are explicit.",
                      "type": "boolean"
                    },
                    "type": {
                      "enum": [
                        "uuid",
                        "text",
                        "date",
                        "numeric(14,2)",
                        "numeric(4,2)"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "nullable",
                    "type"
                  ],
                  "type": "object",
                  "additionalProperties": false
                },
                "minItems": 1,
                "type": "array"
              },
              "foreignKeys": {
                "items": {
                  "description": "ForeignKey links a business uuid column to the id of a shared table.",
                  "properties": {
                    "column": {
                      "pattern": "^[a-z][a-z0-9_]*$",
                      "type": "string"
                    },
                    "references": {
                      "description": "References is a shared table or another table of the same application.",
                      "pattern": "^(core|cap_[a-z]+|domain)\\.[a-z][a-z0-9_]*$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "column",
                    "references"
                  ],
                  "type": "object",
                  "additionalProperties": false
                },
                "type": "array"
              },
              "name": {
                "pattern": "^domain\\.[a-z][a-z0-9_]*$",
                "type": "string"
              },
              "stateMachine": {
                "description": "StateMachine declares states and the commands that move between them. A\ntable without one is edited freely within its access rules.",
                "properties": {
                  "commands": {
                    "items": {
                      "description": "Command is a role-guarded state transition executed by cap-process.",
                      "properties": {
                        "allowedRoles": {
                          "items": {
                            "type": "string"
                          },
                          "minItems": 1,
                          "type": "array"
                        },
                        "from": {
                          "items": {
                            "type": "string"
                          },
                          "minItems": 1,
                          "type": "array"
                        },
                        "name": {
                          "pattern": "^[a-z][a-z0-9_]*$",
                          "type": "string"
                        },
                        "recordFilter": {
                          "type": "object"
                        },
                        "to": {
                          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                          "type": "string"
                        }
                      },
                      "required": [
                        "allowedRoles",
                        "from",
                        "name",
                        "to"
                      ],
                      "type": "object",
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "editableStates": {
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "initial": {
                    "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                    "type": "string"
                  },
                  "terminalStates": {
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "commands",
                  "editableStates",
                  "initial",
                  "terminalStates"
                ],
                "type": "object",
                "additionalProperties": false
              },
              "ui": {
                "description": "UI configures the table's list and form in the App Shell.",
                "properties": {
                  "actions": {
                    "description": "Actions lists the commands of a process table; other tables have none.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "formFields": {
                    "items": {
                      "description": "FormField is one input of the generated form.",
                      "properties": {
                        "label": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "name": {
                          "pattern": "^[a-z][a-z0-9_]*$",
                          "type": "string"
                        },
                        "required": {
                          "type": "boolean"
                        },
                        "type": {
                          "enum": [
                            "uuid",
                            "text",
                            "number",
                            "file",
                            "date"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "label",
                        "name",
                        "required",
                        "type"
                      ],
                      "type": "object",
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "listColumns": {
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "formFields",
                  "listColumns"
                ],
                "type": "object",
                "additionalProperties": false
              }
            },
            "required": [
              "access",
              "columns",
              "name",
              "ui"
            ],
            "type": "object",
            "additionalProperties": false
          },
          "minItems": 1,
          "type": "array"
        },
        "workflows": {
          "description": "Workflows declares the automation flows and their business effects.",
          "items": {
            "description": "Workflow is an automation flow. The definition is inlined because the\ncontroller cannot read package files from inside the cluster.",
            "properties": {
              "effects": {
                "items": {
                  "description": "Effect is a deduplicated business effect executed through cap-process.",
                  "properties": {
                    "fields": {
                      "description": "EffectFields are the literal work item fields owned by the manifest.",
                      "properties": {
                        "assigneeId": {
                          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
                          "type": "string"
                        },
                        "description": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "priority": {
                          "enum": [
                            "LOW",
                            "MEDIUM",
                            "HIGH",
                            "CRITICAL"
                          ],
                          "type": "string"
                        },
                        "title": {
                          "minLength": 1,
                          "type": "string"
                        }
                      },
                      "required": [
                        "description",
                        "priority",
                        "title"
                      ],
                      "type": "object",
                      "additionalProperties": false
                    },
                    "kind": {
                      "enum": [
                        "create_work_item"
                      ],
                      "type": "string"
                    },
                    "stepName": {
                      "pattern": "^[a-z][a-z0-9_]*$",
                      "type": "string"
                    },
                    "whenCommands": {
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1,
                      "type": "array"
                    }
                  },
                  "required": [
                    "fields",
                    "kind",
                    "stepName",
                    "whenCommands"
                  ],
                  "type": "object",
                  "additionalProperties": false
                },
                "minItems": 1,
                "type": "array"
              },
              "file": {
                "description": "File is the package-relative path the definition was read from. It is\ninformational and preserved so that a resource converts back to its package.",
                "pattern": "^workflows/[a-z][a-z0-9_]*\\.yaml$",
                "type": "string"
              },
              "id": {
                "pattern": "^[a-z][a-z0-9_]*$",
                "type": "string"
              },
              "subscribedEvents": {
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "effects",
              "id",
              "subscribedEvents",
              "file"
            ],
            "type": "object",
            "additionalProperties": false
          },
          "type": "array"
        }
      },
      "required": [
        "capabilities",
        "roles",
        "tables"
      ],
      "type": "object",
      "additionalProperties": false
    }
  }
}
