{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dxos.io/contracts/manifest-v1.schema.json",
  "title": "DXApplication manifest (dxos.io/v1alpha1)",
  "$comment": "Structural schema derived from the DXApplication CRD (operator/config/crd/bases). Semantic rules (declared roles, scopes, capabilities, column references) are enforced by operator/internal/manifest.Validate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "dxos.io/v1alpha1"
    },
    "kind": {
      "const": "DXApplication"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "displayName",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "spec": {
      "description": "DXApplicationSpec mirrors the DXApplication manifest contract\n(docs/contracts/data-contracts.md). JSON field names are identical to the\nmanifest so that both forms convert losslessly.",
      "properties": {
        "attachments": {
          "description": "Attachments binds file columns to commands that require a CLEAN scan.",
          "items": {
            "description": "Attachment binds a file column to the commands that require a CLEAN file.",
            "properties": {
              "column": {
                "pattern": "^[a-z][a-z0-9_]*$",
                "type": "string"
              },
              "requireCleanOnCommands": {
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "column",
              "requireCleanOnCommands"
            ],
            "type": "object",
            "additionalProperties": false
          },
          "type": "array"
        },
        "capabilities": {
          "description": "Capabilities lists the Tier 2 capabilities the application depends on.\ncap-process is required.",
          "items": {
            "pattern": "^cap-[a-z]+$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "domainAccess": {
          "description": "DomainAccess declares per-role select/insert/update rules on the domain table.",
          "properties": {
            "insert": {
              "items": {
                "description": "AccessRule allows one role a set of columns within its scope, optionally\nnarrowed by a record filter.",
                "properties": {
                  "columns": {
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "presets": {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "description": "Presets set uuid columns from X-Hasura-User-Id (insert only).",
                    "type": "object"
                  },
                  "recordFilter": {
                    "type": "object",
                    "description": "RecordFilter is a Hasura boolean expression over declared columns."
                  },
                  "role": {
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "type": "string"
                  },
                  "scope": {
                    "description": "Scope is required on select and update: own records, own department\n(requires cap-hr) or the whole organization. Not allowed on insert.",
                    "enum": [
                      "own",
                      "department",
                      "organization"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "columns",
                  "role"
                ],
                "type": "object",
                "additionalProperties": false
              },
              "minItems": 1,
              "type": "array"
            },
            "select": {
              "items": {
                "description": "AccessRule allows one role a set of columns within its scope, optionally\nnarrowed by a record filter.",
                "properties": {
                  "columns": {
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "presets": {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "description": "Presets set uuid columns from X-Hasura-User-Id (insert only).",
                    "type": "object"
                  },
                  "recordFilter": {
                    "type": "object",
                    "description": "RecordFilter is a Hasura boolean expression over declared columns."
                  },
                  "role": {
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "type": "string"
                  },
                  "scope": {
                    "description": "Scope is required on select and update: own records, own department\n(requires cap-hr) or the whole organization. Not allowed on insert.",
                    "enum": [
                      "own",
                      "department",
                      "organization"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "columns",
                  "role"
                ],
                "type": "object",
                "additionalProperties": false
              },
              "minItems": 1,
              "type": "array"
            },
            "update": {
              "items": {
                "description": "AccessRule allows one role a set of columns within its scope, optionally\nnarrowed by a record filter.",
                "properties": {
                  "columns": {
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "presets": {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "description": "Presets set uuid columns from X-Hasura-User-Id (insert only).",
                    "type": "object"
                  },
                  "recordFilter": {
                    "type": "object",
                    "description": "RecordFilter is a Hasura boolean expression over declared columns."
                  },
                  "role": {
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "type": "string"
                  },
                  "scope": {
                    "description": "Scope is required on select and update: own records, own department\n(requires cap-hr) or the whole organization. Not allowed on insert.",
                    "enum": [
                      "own",
                      "department",
                      "organization"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "columns",
                  "role"
                ],
                "type": "object",
                "additionalProperties": false
              },
              "type": "array"
            }
          },
          "required": [
            "insert",
            "select"
          ],
          "type": "object",
          "additionalProperties": false
        },
        "domainTable": {
          "description": "DomainTable declares the isolated business table generated by the Operator.",
          "properties": {
            "columns": {
              "items": {
                "description": "Column is a business column; system columns are managed by the Operator.",
                "properties": {
                  "check": {
                    "description": "Check is a SQL CHECK expression from the validator's allowlist.",
                    "type": "string"
                  },
                  "name": {
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "type": "string"
                  },
                  "nullable": {
                    "description": "Nullable is required so that additive upgrades are explicit.",
                    "type": "boolean"
                  },
                  "type": {
                    "enum": [
                      "uuid",
                      "text",
                      "date",
                      "numeric(14,2)",
                      "numeric(4,2)"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "nullable",
                  "type"
                ],
                "type": "object",
                "additionalProperties": false
              },
              "minItems": 1,
              "type": "array"
            },
            "foreignKeys": {
              "items": {
                "description": "ForeignKey links a business uuid column to the id of a shared table.",
                "properties": {
                  "column": {
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "type": "string"
                  },
                  "references": {
                    "pattern": "^(core|cap_[a-z]+)\\.[a-z][a-z0-9_]*$",
                    "type": "string"
                  }
                },
                "required": [
                  "column",
                  "references"
                ],
                "type": "object",
                "additionalProperties": false
              },
              "type": "array"
            },
            "name": {
              "pattern": "^domain\\.[a-z][a-z0-9_]*$",
              "type": "string"
            }
          },
          "required": [
            "columns",
            "name"
          ],
          "type": "object",
          "additionalProperties": false
        },
        "roles": {
          "description": "Roles are owned by this application; no other application may use them.",
          "items": {
            "description": "Role is one application role (core.roles).",
            "properties": {
              "description": {
                "type": "string"
              },
              "name": {
                "pattern": "^[a-z][a-z0-9_]*$",
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "type": "object",
            "additionalProperties": false
          },
          "minItems": 1,
          "type": "array"
        },
        "sharedAccess": {
          "description": "SharedAccess declares the shared Tier 1 and Tier 2 tables, columns and\nroles the application reads.",
          "items": {
            "description": "SharedAccess grants read access to a shared Tier 1 or Tier 2 table.",
            "properties": {
              "columns": {
                "items": {
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "roles": {
                "items": {
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "table": {
                "pattern": "^(core|cap_[a-z]+)\\.[a-z][a-z0-9_]*$",
                "type": "string"
              }
            },
            "required": [
              "columns",
              "roles",
              "table"
            ],
            "type": "object",
            "additionalProperties": false
          },
          "type": "array"
        },
        "stateMachine": {
          "description": "StateMachine declares states and the commands that move between them.",
          "properties": {
            "commands": {
              "items": {
                "description": "Command is a role-guarded state transition executed by cap-process.",
                "properties": {
                  "allowedRoles": {
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "from": {
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "name": {
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "type": "string"
                  },
                  "recordFilter": {
                    "type": "object",
                    "description": ""
                  },
                  "to": {
                    "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                    "type": "string"
                  }
                },
                "required": [
                  "allowedRoles",
                  "from",
                  "name",
                  "to"
                ],
                "type": "object",
                "additionalProperties": false
              },
              "minItems": 1,
              "type": "array"
            },
            "editableStates": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "initial": {
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "type": "string"
            },
            "terminalStates": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "commands",
            "editableStates",
            "initial",
            "terminalStates"
          ],
          "type": "object",
          "additionalProperties": false
        },
        "uiSchema": {
          "description": "UISchema configures the schema-driven App Shell.",
          "properties": {
            "actions": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "formFields": {
              "items": {
                "description": "FormField is one input of the generated form.",
                "properties": {
                  "label": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "name": {
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "type": "string"
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "type": {
                    "enum": [
                      "uuid",
                      "text",
                      "number",
                      "file",
                      "date"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "name",
                  "required",
                  "type"
                ],
                "type": "object",
                "additionalProperties": false
              },
              "minItems": 1,
              "type": "array"
            },
            "listColumns": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "actions",
            "formFields",
            "listColumns"
          ],
          "type": "object",
          "additionalProperties": false
        },
        "workflows": {
          "description": "Workflows declares the automation flows and their business effects.",
          "items": {
            "description": "Workflow is an automation flow. The definition is inlined because the\ncontroller cannot read package files from inside the cluster.",
            "properties": {
              "effects": {
                "items": {
                  "description": "Effect is a deduplicated business effect executed through cap-process.",
                  "properties": {
                    "fields": {
                      "description": "EffectFields are the literal work item fields owned by the manifest.",
                      "properties": {
                        "assigneeId": {
                          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
                          "type": "string"
                        },
                        "description": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "priority": {
                          "enum": [
                            "LOW",
                            "MEDIUM",
                            "HIGH",
                            "CRITICAL"
                          ],
                          "type": "string"
                        },
                        "title": {
                          "minLength": 1,
                          "type": "string"
                        }
                      },
                      "required": [
                        "description",
                        "priority",
                        "title"
                      ],
                      "type": "object",
                      "additionalProperties": false
                    },
                    "kind": {
                      "enum": [
                        "create_work_item"
                      ],
                      "type": "string"
                    },
                    "stepName": {
                      "pattern": "^[a-z][a-z0-9_]*$",
                      "type": "string"
                    },
                    "whenCommands": {
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1,
                      "type": "array"
                    }
                  },
                  "required": [
                    "fields",
                    "kind",
                    "stepName",
                    "whenCommands"
                  ],
                  "type": "object",
                  "additionalProperties": false
                },
                "minItems": 1,
                "type": "array"
              },
              "file": {
                "description": "File is the package-relative path the definition was read from. It is\ninformational and preserved so that a resource converts back to its package.",
                "pattern": "^workflows/[a-z][a-z0-9_]*\\.yaml$",
                "type": "string"
              },
              "id": {
                "pattern": "^[a-z][a-z0-9_]*$",
                "type": "string"
              },
              "subscribedEvents": {
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "effects",
              "id",
              "subscribedEvents",
              "file"
            ],
            "type": "object",
            "additionalProperties": false
          },
          "type": "array"
        }
      },
      "required": [
        "capabilities",
        "domainAccess",
        "domainTable",
        "roles",
        "stateMachine",
        "uiSchema"
      ],
      "type": "object",
      "additionalProperties": false
    }
  }
}
