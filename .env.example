# Address published ports listen on. Keep 127.0.0.1 unless every secret below
# has been replaced (scripts/init-env.sh does that).
BIND_ADDRESS=127.0.0.1

# PostgreSQL
POSTGRES_DB=dxos_db
POSTGRES_USER=dxos_admin
POSTGRES_PASSWORD=dxos_secret
POSTGRES_PORT=5432
# Capabilities loaded at database init; the sample apps need these four.
ENABLED_CAPABILITIES=cap-process,cap-hr,cap-work,cap-data,cap-ai

# Hasura GraphQL Engine
HASURA_PORT=8080
HASURA_ADMIN_SECRET=dxos_admin_secret

# Keycloak OIDC
KEYCLOAK_PORT=8085
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_ISSUER_URL=http://localhost:8085/realms/dxos
OIDC_JWKS_URL=http://keycloak:8085/realms/dxos/protocol/openid-connect/certs
OIDC_AUDIENCE=dxos-runtime

# OpenTelemetry (optional). Set the OTLP/HTTP endpoint of an operator-run
# Collector; leave it empty to keep the SDK exporters off. The service name is
# set per Compose service, so set OTEL_SERVICE_NAME only for a custom deployment.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=
OTEL_TRACES_EXPORTER=otlp
# APISIX: always_on sends gateway spans to the Collector (host:port, OTLP/HTTP).
OTEL_APISIX_SAMPLER=always_off
OTEL_COLLECTOR_ADDRESS=127.0.0.1:4318
# Keycloak 26.0 tracing is a preview feature.
KC_FEATURES=opentelemetry
KC_TRACING_ENABLED=false
KC_TRACING_ENDPOINT=
KC_TRACING_PROTOCOL=http/protobuf
KC_METRICS_ENABLED=false
# default or json
KC_LOG_CONSOLE_OUTPUT=default
# Kestra traces and OTLP metrics.
KESTRA_OTEL_ENABLED=false
KESTRA_TRACES_ROOT=DISABLED
KESTRA_OTLP_METRICS_ENABLED=false
# Kestra's trace exporter is OTLP/gRPC: the Collector gRPC address (4317).
KESTRA_OTEL_ENDPOINT=

# First platform operator: the Keycloak account with this email becomes
# role_operator on its first sign-in, while no user holds that role. Operators
# then assign roles through /api/auth/users/{id}/roles/{role}.
BOOTSTRAP_OPERATOR_EMAIL=

# Apache APISIX Gateway
APISIX_GATEWAY_PORT=9080

# Kestra Workflow Engine
KESTRA_PORT=8082
KESTRA_USER=admin@dxos.local
KESTRA_PASSWORD=change-me-local-kestra
# Key of the webhook trigger of application flows: cap-process sends events to
# it, and Kestra holds it as the secret DXOS_WEBHOOK_KEY.
KESTRA_WEBHOOK_KEY=change-me-local-webhook-key
# Kestra's own database and role are created at database init (08_runtime_passwords.sh).
KESTRA_DATABASE_PASSWORD=change-me-local-kestra-database
# The workflow engine calls cap-process as the platform's workflow service
# account (seeded in core.users), presenting this credential (32+ characters).
WORKFLOW_SERVICE_TOKEN=change-me-local-workflow-service-token
WORKFLOW_SERVICE_USER_ID=22222222-2222-4222-8222-000000000005
WORKFLOW_SERVICE_ROLE=role_workflow

# SeaweedFS & ClamAV
SEAWEEDFS_S3_PORT=8333
S3_ENDPOINT=http://seaweedfs:8333
S3_BUCKET=dxos-attachments
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=dxos_s3_access_key
S3_SECRET_ACCESS_KEY=dxos_s3_secret_key
CLAMAV_PORT=3310
CLAMAV_ADDRESS=clamav:3310

# Operator: installs exactly the application packages in OPERATOR_APPS_DIR,
# checking every OPERATOR_RECONCILE_INTERVAL.
OPERATOR_APPS_DIR=./apps
OPERATOR_RECONCILE_INTERVAL=30s

# Tier 2 Capability Services & UI Shell
CAP_PROCESS_PORT=8091
WORKSPACE_UI_PORT=5173

# Disposable handoff only: environment.py generates private .env.integration.
# Set acknowledgements in the calling shell, never use against a shared database.
# TEST_DISPOSABLE_DATABASE=yes
# TEST_ALLOW_RESET=opendx-integration
# COMPOSE_PROJECT_NAME=opendx-integration
# Run TEST_DISPOSABLE_DATABASE=yes python3 scripts/integration/environment.py roles
# Generates private INTEGRATION_{PROCESS,HASURA,READER,CALLER,MODULE_TEST}_PASSWORD values.

# Restricted runtime connection passwords, applied to their roles at database init
# (08_runtime_passwords.sh). Init runs once per data volume: after changing them,
# recreate the volume (docker compose down -v) or run ALTER ROLE yourself.
# Bootstrap POSTGRES_USER is only for schema/operator administration.
HASURA_DATABASE_PASSWORD=change-me-local-hasura-db
PROCESS_DATABASE_PASSWORD=change-me-local-process-db
AUTHZ_DATABASE_PASSWORD=change-me-local-authz-db
# cap-hr connects as dxos_hr: it reads the organization and changes it only
# through audited database functions.
HR_DATABASE_PASSWORD=change-me-local-hr-db

# Secret of the read-only Keycloak client dxos-directory, with which dxos-authz
# lists accounts that have not signed in yet, so operators can grant them roles.
# Empty: people appear at their first sign-in. scripts/init-env.sh fills it in.
KEYCLOAK_DIRECTORY_SECRET=

# Kubernetes only (deploy/k8s): Keycloak's login to its own PostgreSQL database
# (production mode). Compose keeps Keycloak's file store and ignores it.
KEYCLOAK_DATABASE_PASSWORD=change-me-local-keycloak-db

# dxos-authz reuses a user's role grants for this long; a revoked role stops
# working within it (ADR 0007).
ROLE_CACHE_TTL=5s

# Public origin Keycloak puts in the token issuer. It must match the origin of
# OIDC_ISSUER_URL; internal services request tokens from keycloak:8085, and a
# fixed hostname keeps their tokens verifiable against the public issuer.
KEYCLOAK_HOSTNAME=http://localhost:8085

# The optional AI Compose overlay generates its secrets in .env; set
# AI_ENV_FILE to another path to keep them in a separate file.
# See docs/guides/knowledge/models.md for provider allowlists.
# The static bearer tokens below are optional: leave them empty to use the
# client-id/secret pairs, which renew automatically. A static token wins when set.
RAG_PRIVATE_UPLOAD_ENABLED=true
AI_DATABASE_PASSWORD=
AI_WORKER_DATABASE_PASSWORD=
AI_DISPATCHER_DATABASE_PASSWORD=
AI_BROKER_DATABASE_PASSWORD=
AI_MODEL_MASTER_KEY=
AI_HOSTED_MODEL_ENDPOINTS='["https://api.openai.com/v1","https://openrouter.ai/api/v1"]'
AI_LOCAL_MODEL_ENDPOINTS={}

RAG_WORKER_SERVICE_SUBJECT=33333333-3333-4333-8333-000000000001
RAG_FILE_SERVICE_SUBJECT=33333333-3333-4333-8333-000000000002
RAG_DISPATCHER_SERVICE_SUBJECT=33333333-3333-4333-8333-000000000003
RAG_WORKER_CLIENT_ID=dxos-rag-worker
RAG_FILE_CLIENT_ID=dxos-file-service
RAG_DISPATCHER_CLIENT_ID=dxos-rag-dispatcher
RAG_WORKER_CLIENT_SECRET=
RAG_FILE_CLIENT_SECRET=
RAG_DISPATCHER_CLIENT_SECRET=
RAG_WORKER_BEARER_TOKEN=
RAG_FILE_BEARER_TOKEN=
RAG_DISPATCHER_BEARER_TOKEN=
