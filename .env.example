# PostgreSQL
POSTGRES_DB=dxos
POSTGRES_USER=dxos_admin
POSTGRES_PASSWORD=change-me-local-postgres

# Hasura GraphQL Engine
HASURA_GRAPHQL_PORT=8080
HASURA_GRAPHQL_ADMIN_SECRET=change-me-local-hasura-admin

# Keycloak OIDC
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-keycloak

# Apache APISIX Gateway
APISIX_GATEWAY_PORT=9080

# Kestra Workflow Engine
KESTRA_PORT=8082
KESTRA_USER=admin@dxos.local
KESTRA_PASSWORD=change-me-local-kestra

# SeaweedFS & ClamAV
SEAWEEDFS_S3_PORT=8333
CLAMAV_PORT=3310

# OpenBao
OPENBAO_PORT=8200
OPENBAO_ROOT_TOKEN=change-me-local-openbao

# Tier 2 Capability Services & UI Shell
CAP_PROCESS_PORT=8091
CAP_DATA_PORT=8092
CAP_AI_PORT=8093
WORKSPACE_UI_PORT=5173
