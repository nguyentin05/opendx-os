# PostgreSQL
POSTGRES_DB=dxos_db
POSTGRES_USER=dxos_admin
POSTGRES_PASSWORD=dxos_secret
POSTGRES_PORT=5432
ENABLED_CAPABILITIES=cap-process

# Hasura GraphQL Engine
HASURA_PORT=8080
HASURA_ADMIN_SECRET=dxos_admin_secret

# Keycloak OIDC
KEYCLOAK_PORT=8085
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_ISSUER_URL=http://localhost:8085/realms/dxos
OIDC_JWKS_URL=http://keycloak:8085/realms/dxos/protocol/openid-connect/certs
OIDC_AUDIENCE=dxos-runtime

# Apache APISIX Gateway
APISIX_GATEWAY_PORT=9080

# Kestra Workflow Engine
KESTRA_PORT=8082
KESTRA_USER=admin@dxos.local
KESTRA_PASSWORD=change-me-local-kestra
KESTRA_URL=http://kestra:8080/api/v1/executions/webhook/dxos/procurement_approval_flow/webhook-key
KESTRA_API_TOKEN=change-me-local-kestra-token
WORKFLOW_SERVICE_USER_ID=22222222-2222-4222-8222-000000000005
WORKFLOW_SERVICE_ROLE=role_workflow

# SeaweedFS & ClamAV
SEAWEEDFS_S3_PORT=8333
S3_ENDPOINT=http://seaweedfs:8333
S3_BUCKET=dxos-attachments
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=dxos_s3_access_key
S3_SECRET_ACCESS_KEY=dxos_s3_secret_key
CLAMAV_PORT=3310
CLAMAV_ADDRESS=clamav:3310

# Tier 2 Capability Services & UI Shell
CAP_PROCESS_PORT=8091
WORKSPACE_UI_PORT=5173

# Disposable handoff only: environment.py generates private .env.integration.
# Set acknowledgements in the calling shell, never use against a shared database.
# TEST_DISPOSABLE_DATABASE=yes
# TEST_ALLOW_RESET=opendx-integration
# COMPOSE_PROJECT_NAME=opendx-integration
# Run TEST_DISPOSABLE_DATABASE=yes python3 scripts/integration/environment.py roles
# Generates private INTEGRATION_{PROCESS,HASURA,READER,CALLER,MODULE_TEST}_PASSWORD values.

# Restricted runtime connection passwords; provision roles before starting services.
# Bootstrap POSTGRES_USER is only for schema/operator administration.
HASURA_DATABASE_PASSWORD=
PROCESS_DATABASE_PASSWORD=
