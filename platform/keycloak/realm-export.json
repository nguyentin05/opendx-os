{
  "realm": "dxos",
  "enabled": true,
  "displayName": "DX-OS Open-Core Realm",
  "sslRequired": "external",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "role_operator",
        "description": "Platform and infrastructure operator role"
      },
      {
        "name": "role_auditor",
        "description": "System auditor role for cross-workspace compliance"
      },
      {
        "name": "role_workflow_service",
        "description": "Trusted Kestra workflow effect service role"
      }
    ]
  },
  "clients": [
    {
      "clientId": "dxos-portal",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:9080/*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocolMappers": [
        {
          "name": "dxos-runtime-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "dxos-runtime",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "hasura-user-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "id",
            "claim.name": "https://hasura.io/jwt/claims.x-hasura-user-id",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "hasura-workspace-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "workspace_id",
            "claim.name": "https://hasura.io/jwt/claims.x-hasura-workspace-id",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "hasura-default-role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "default_role",
            "claim.name": "https://hasura.io/jwt/claims.x-hasura-default-role",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "hasura-allowed-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "https://hasura.io/jwt/claims.x-hasura-allowed-roles",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
