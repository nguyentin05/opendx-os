# Kubernetes operator image: only the dxos-controller binary. The CLI and
# Compose installer image is Dockerfile (dxos-operator).
FROM golang:1.27.4-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/dxos-controller ./cmd/dxos-controller

FROM alpine:3.23
RUN adduser -D -u 10001 dxos
COPY --from=builder /out/dxos-controller /usr/local/bin/dxos-controller
# Numeric user so Kubernetes can verify runAsNonRoot.
USER 10001:10001
# Apache-2.0 section 4: the license, notices and third-party license texts ship
# with the binaries. `legal` is the repository root, passed as a named build context.
COPY --from=legal LICENSE NOTICE COPYRIGHT.txt THIRD_PARTY_LICENSES.txt /usr/share/licenses/opendx-os/
ENTRYPOINT ["/usr/local/bin/dxos-controller"]
